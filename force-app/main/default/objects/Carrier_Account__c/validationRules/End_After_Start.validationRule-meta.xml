<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_After_Start</fullName>
    <active>true</active>
    <description>Contract dates.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Contract_Start__c)), NOT(ISBLANK(Contract_End__c)), Contract_End__c &lt; Contract_Start__c)</errorConditionFormula>
    <errorDisplayField>Contract_End__c</errorDisplayField>
    <errorMessage>Contract end must be on or after start.</errorMessage>
</ValidationRule>
