<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Reopen_Closed</fullName>
    <active>true</active>
    <description>PRIORVALUE: closed shipments cannot be reopened.</description>
    <errorConditionFormula>AND(ISCHANGED(Status__c), OR(ISPICKVAL(PRIORVALUE(Status__c),'Delivered'), ISPICKVAL(PRIORVALUE(Status__c),'Cancelled')))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Delivered or cancelled shipments cannot be reopened.</errorMessage>
</ValidationRule>
