<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Delayed__c</fullName>
    <description>True when the revised ETA is later than plan.</description>
    <label>Is Delayed</label>
    <formula>AND(NOT(ISPICKVAL(Status__c,'Delivered')), NOT(ISPICKVAL(Status__c,'Cancelled')), NOT(ISBLANK(Revised_ETA__c)), NOT(ISBLANK(Planned_Arrival__c)), Revised_ETA__c &gt; Planned_Arrival__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <type>Checkbox</type>
</CustomField>
